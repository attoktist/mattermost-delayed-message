{
  "id": "com.attoktist.scheduled-posts",
  "name": "Delayed Messages",
  "description": "Отложенные сообщения без лицензии Professional.",
  "version": "1.1.0",
  "min_server_version": "12.0.0",
  "server": {
    "executables": {
      "linux-amd64": "server/dist/plugin-linux-amd64",
      "linux-arm64": "server/dist/plugin-linux-arm64",
      "darwin-amd64": "server/dist/plugin-darwin-amd64",
      "darwin-arm64": "server/dist/plugin-darwin-arm64",
      "windows-amd64": "server/dist/plugin-windows-amd64.exe"
    }
  },
  "webapp": {
    "bundle_path": "webapp/dist/main.js"
  },
  "settings_schema": {
    "header": "",
    "footer": "",
    "settings": [
      {
        "key": "PollIntervalSeconds",
        "display_name": "Интервал опроса (секунды)",
        "type": "number",
        "help_text": "Как часто проверять, пора ли отправить отложенные. Минимум 5.",
        "default": 30
      },
      {
        "key": "MaxAttempts",
        "display_name": "Число попыток",
        "type": "number",
        "help_text": "Сколько раз повторять отправку, если все каналы отказали. От 1 до 10.",
        "default": 3
      },
      {
        "key": "DefaultTimezone",
        "display_name": "Часовой пояс по умолчанию",
        "type": "text",
        "help_text": "IANA-имя, например Europe/Moscow. Пустое или неверное значение заменяется на UTC.",
        "default": "UTC"
      }
    ]
  }
}
